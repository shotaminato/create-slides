{
  "name": "create-slides",
  "version": "1.0.0",
  "description": "Config-driven PowerPoint (.pptx) generator from YAML slide configs",
  "type": "module",
  "bin": {
    "create-slides": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build-slides": "tsx src/cli.ts",
    "create-slides": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "yaml",
    "slides",
    "pptxgenjs"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.1",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
